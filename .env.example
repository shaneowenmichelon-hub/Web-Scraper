# Copy to .env and fill in. Never commit .env.
# Get a key at https://dashboard.exa.ai/api-keys
EXA_API_KEY=your_exa_api_key_here

# Dashboard server port
PORT=3000

# Scraper defaults (override with CLI flags)
DEFAULT_RESULTS_PER_QUERY=8
# Exa publishes a 10 req/sec rate limit. We default to concurrency=2 plus a
# 150ms global min-gap (set in exa-client.js) to stay well under it. Raise
# only if you've negotiated a higher plan.
SCRAPE_CONCURRENCY=2
EXA_MIN_GAP_MS=150
